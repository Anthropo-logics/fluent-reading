    "ocr.keep.failed.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your document was left exactly as it was: nothing changed. You can carry on reading it as usual and try again the next time you close it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu documento quedó tal y como estaba: no se cambió nada. Puedes seguir leyéndolo con normalidad y volver a intentarlo la próxima vez que lo cierres."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu documento ficou exatamente como estava: nada foi alterado. Você pode continuar lendo normalmente e tentar de novo na próxima vez que o fechar."
          }
        }
      }
    },
    "ocr.keep.failed.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recognised text could not be kept"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el texto reconocido"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível guardar o texto reconhecido"
          }
        }
      }
    },
    "ocr.keep.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This PDF carried no readable text, so Fluent Reading recognised it while you were reading. If you keep it inside the document, the next time you open it everything will be ready straight away, with no wait for the recognition to run again. The document will look exactly as it does now: the text sits underneath the page without changing its appearance, and leaves the PDF tidier and more accessible, in other apps too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este PDF no traía un texto legible, así que Lectura Fluida lo reconoció mientras leías. Si lo guardas dentro del documento, la próxima vez que lo abras estará listo al instante, sin esperar a que el reconocimiento se repita. El documento se verá exactamente igual que ahora: el texto queda por debajo de la página, sin cambiar su aspecto, y deja el PDF más ajustado y más accesible, también en otras aplicaciones."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este PDF não trazia um texto legível, então a Leitura Fluída o reconheceu enquanto você lia. Se você o guardar dentro do documento, na próxima vez que o abrir tudo estará pronto de imediato, sem esperar que o reconhecimento se repita. O documento continuará com o mesmo aspecto de agora: o texto fica por baixo da página, sem mudar sua aparência, e deixa o PDF mais ajustado e mais acessível, também em outros aplicativos."
          }
        }
      }
    },
    "ocr.keep.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the recognised text in this document?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Guardar el texto reconocido en este documento?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar o texto reconhecido neste documento?"
          }
        }
      }
    },
    "privacy.local": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything happens on your device: reading the PDF, text recognition, narration, and audiobook export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo ocurre en tu dispositivo: la lectura del PDF, el reconocimiento de texto, la narración y la exportación del audiolibro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo acontece no seu dispositivo: a leitura do PDF, o reconhecimento de texto, a narração e a exportação do audiolivro."
          }
        }
      }
    },
    "privacy.network": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The only network connection is the initial, explicit download of the voice model you choose. Once it is installed, the whole flow works with no network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La única conexión de red es la descarga inicial y explícita del modelo de voz que elijas. Una vez instalado, todo el flujo funciona sin red."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A única conexão de rede é o download inicial e explícito do modelo de voz que você escolher. Depois de instalado, todo o fluxo funciona sem rede."
          }
        }
      }
    },
    "privacy.no_telemetry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no telemetry, no usage analytics, and no user account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay telemetría, no hay analítica de uso y no hay cuenta de usuario."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há telemetria, não há análise de uso e não há conta de usuário."
          }
        }
      }
    },
    "privacy.no_upload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your document, its text, and the generated audio are never sent to any server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu documento, su texto y el audio generado nunca se envían a ningún servidor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu documento, seu texto e o áudio gerado nunca são enviados a nenhum servidor."
          }
        }
      }
    },
    "privacy.permissions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app requests only the permissions it uses: the files you choose to open or save, and the network access needed to download the voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación solo solicita los permisos que usa: los archivos que eliges abrir o guardar y el acceso de red necesario para descargar la voz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo solicita apenas as permissões que usa: os arquivos que você escolhe abrir ou salvar e o acesso à rede necessário para baixar a voz."
          }
        }
      }
    },
    "privacy.storage": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Derived data stays in the app's local storage and you can delete it whenever you want from “Storage…”."
