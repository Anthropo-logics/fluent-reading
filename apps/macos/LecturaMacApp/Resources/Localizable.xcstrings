    "settings.relaunch.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart to apply the language"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia para aplicar el idioma"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicie para aplicar o idioma"
          }
        }
      }
    },
    "settings.relaunch.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS decides an app’s language when it starts, so Fluent Reading has to restart to show the new one. Your preferences and the reading progress already saved are kept; the open document closes and any narration in progress stops, so you can restart later if you are in the middle of a reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS decide el idioma de una aplicación al arrancarla, así que Lectura Fluida tiene que reiniciarse para mostrar el nuevo. Tus preferencias y el progreso de lectura ya guardado se conservan; el documento abierto se cierra y la narración en curso se detiene, así que puedes reiniciar más tarde si estás a media lectura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS decide o idioma de um aplicativo ao iniciá-lo, então o Leitura Fluída precisa reiniciar para mostrar o novo. Suas preferências e o progresso de leitura já salvo são mantidos; o documento aberto é fechado e a narração em andamento é interrompida, então você pode reiniciar mais tarde se estiver no meio de uma leitura."
          }
        }
      }
    },
    "settings.relaunch.now": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart now"
          }
        },
