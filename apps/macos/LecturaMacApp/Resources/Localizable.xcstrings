        }
      }
    },
    "tutorial.voice.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time there is no voice installed: open \"Voice…\" in the ⋯ menu and download it once — a normal step, not a failure. Language and voice are chosen there too, and you can change them whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La primera vez no hay ninguna voz instalada: abre \"Voz…\" en el menú ⋯ y descárgala una sola vez — es un paso normal, no un fallo. Ahí mismo eliges el idioma y la voz, y puedes cambiarlos cuando quieras."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na primeira vez não há nenhuma voz instalada: abra \"Voz…\" no menu ⋯ e baixe-a uma única vez — é um passo normal, não uma falha. Ali mesmo você escolhe o idioma e a voz, e pode mudá-los quando quiser."
          }
        }
      }
    },
    "tutorial.voice.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice, the first time"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La voz, la primera vez"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A voz, na primeira vez"
          }
        }
      }
    },
    "tutorial.welcome.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick tour of the real controls, so reading, listening and translating make sense from the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recorrido breve por los controles reales, para que leer, escuchar y traducir tengan sentido desde el principio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma breve visita guiada pelos controles reais, para que ler, ouvir e traduzir façam sentido desde o início."
          }
        }
      }
    },
    "tutorial.views.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF and Immersion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF e Inmersión"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF e Imersão"
          }
        }
      }
    },
    "tutorial.views.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This switch shows the original page or a continuous, reflowed text. The button beside it opens the document outline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este interruptor muestra la página original o un texto continuo y refluido. El botón junto a él abre la estructura del documento."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este interruptor mostra a página original ou um texto contínuo e refluído. O botão ao lado abre a estrutura do documento."
          }
        }
      }
    },
    "tutorial.start_reading.pdf.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start reading anywhere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a leer donde quieras"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a ler onde quiser"
          }
        }
      }
    },
    "tutorial.start_reading.pdf.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click any passage on the page to start narration right there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en cualquier pasaje de la página para empezar la narración justo ahí."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes em qualquer trecho da página para começar a narração ali mesmo."
          }
        }
      }
    },
    "tutorial.start_reading.immersion.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start reading anywhere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a leer donde quieras"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a ler onde quiser"
          }
        }
      }
    },
    "tutorial.start_reading.immersion.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click a paragraph to start narration from it; a single click just moves the anchor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en un párrafo para empezar la narración desde ahí; un solo clic sólo mueve el ancla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique duas vezes em um parágrafo para começar a narração a partir dele; um único clique apenas move a âncora."
          }
        }
      }
    },
    "tutorial.transport.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducción"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprodução"
          }
        }
      }
    },
    "tutorial.transport.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play and pause the narration and jump between units. The margin caret follows along as the voice reads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce y pausa la narración y salta entre unidades. El indicador del margen avanza con la voz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz e pausa a narração e salta entre unidades. O indicador da margem acompanha a voz."
          }
        }
      }
    },
    "tutorial.translate.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducción"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tradução"
          }
        }
      }
    },
    "tutorial.translate.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional: the same ⋯ menu has \"Translate…\", which downloads a local model the first time you ask for it, not before. Then the Narration switch moves between Original and Translation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: el mismo menú ⋯ tiene \"Traducir…\", que descarga un modelo local la primera vez que lo pides, no antes. Después, el interruptor de Narración cambia entre Original y Traducción."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: o mesmo menu ⋯ tem \"Traduzir…\", que baixa um modelo local na primeira vez que você pedir, não antes. Depois, o interruptor de Narração alterna entre Original e Tradução."
          }
        }
      }
    },
    "tutorial.export.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export as audiobook"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar como audiolibro"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar como audiolivro"
          }
        }
      }
    },
    "tutorial.export.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same ⋯ menu has \"Export audio…\" — it exports whichever narration you are currently listening to, Original or Translation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo menú ⋯ tiene \"Exportar audio…\" — exporta la narración que estés escuchando en ese momento, Original o Traducción."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo menu ⋯ tem \"Exportar áudio…\" — exporta a narração que você estiver ouvindo naquele momento, Original ou Tradução."
          }
        }
      }
    },
