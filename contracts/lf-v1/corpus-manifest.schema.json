{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lf-v1/corpus-manifest.schema.json",
  "title": "Lectura corpus manifest v1",
  "type": "object",
  "required": ["schema_version", "corpus_id", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": { "$ref": "#/$defs/id" },
    "entries": {
      "type": "array",
      "minItems": 14,
      "items": {
        "type": "object",
        "required": ["id", "role", "file", "sha256", "byte_size", "provenance", "classification", "language", "required", "distributable", "page_count", "pages_evaluated", "ground_truth"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "enum": ["matrix", "long_form", "adversarial"] },
          "file": { "$ref": "#/$defs/relativePath" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "byte_size": { "type": "integer", "minimum": 1 },
          "provenance": {
            "type": "object",
            "required": ["source", "permission", "evidence"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "permission": { "enum": ["owned", "generated", "cc0", "cc_by"] },
              "evidence": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "classification": {
            "type": "object",
            "required": ["layout", "content"],
            "properties": {
              "layout": { "enum": ["single_column", "multi_column"] },
              "content": { "enum": ["digital", "scanned", "mixed"] }
            },
            "additionalProperties": false
          },
          "language": { "enum": ["es", "en", "pt"] },
          "required": { "type": "boolean" },
          "distributable": { "const": true },
          "page_count": { "type": "integer", "minimum": 1 },
          "pages_evaluated": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
          "ground_truth": { "$ref": "#/$defs/relativePath" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
  },
  "additionalProperties": false
}
