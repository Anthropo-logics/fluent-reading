{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lf-v1/commands.schema.json",
  "title": "LF v1 request",
  "type": "object",
  "required": ["schema_version", "request_id", "command", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "command": { "enum": ["canary", "plan_spoken_text", "open_document", "plan_session", "mutate_session", "normalize_page", "tts_synthesize", "gate_a_run"] },
    "payload": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "command": { "const": "canary" },
        "payload": { "type": "object", "maxProperties": 0 }
      }
    },
    {
      "properties": {
        "command": { "const": "plan_spoken_text" },
        "payload": {
          "type": "object",
          "required": ["text", "language"],
          "properties": {
            "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
            "language": { "enum": ["es", "en", "pt"] }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "command": { "const": "open_document" },
        "payload": {
          "type": "object",
          "required": ["access_grant_id", "document_fingerprint", "page_count", "first_page_ms"],
          "properties": {
            "access_grant_id": { "type": "string", "minLength": 1, "maxLength": 256 },
            "document_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "page_count": { "type": "integer", "minimum": 1 },
            "first_page_ms": { "type": "integer", "minimum": 0 },
            "furniture_pages": {
              "type": "array",
              "maxItems": 64,
              "items": { "$ref": "#/$defs/page_extraction" }
            }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "command": { "const": "plan_session" },
        "payload": { "$ref": "incremental-session.schema.json#/$defs/request" }
      }
    },
    {
      "properties": {
        "command": { "const": "mutate_session" },
        "payload": { "$ref": "incremental-session.schema.json#/$defs/mutation" }
      }
    },
    {
      "properties": {
        "command": { "const": "normalize_page" },
        "payload": {
          "type": "object",
          "required": ["page", "language", "requested_unit", "route", "adapter_status"],
          "properties": {
            "page": { "$ref": "#/$defs/page_extraction" },
            "language": { "enum": ["es", "en", "pt"] },
            "requested_unit": { "enum": ["paragraph", "sentence"] },
            "route": { "enum": ["direct_text", "ocr"] },
            "adapter_status": { "enum": ["completed", "degraded", "failed"] },
            "raster_content_detected": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "command": { "const": "tts_synthesize" },
        "payload": { "$ref": "tts-synthesis.schema.json#/$defs/requestPayload" }
      }
    },
    {
      "properties": {
        "command": { "const": "gate_a_run" },
        "payload": { "$ref": "gate-a-run.schema.json#/$defs/request" }
      }
    }
  ],
  "$defs": {
    "source_region": {
      "type": "object",
      "required": ["page_index", "rect_pdf_points", "page_rotation_degrees", "source_to_page_transform", "confidence"],
      "properties": {
        "page_index": { "type": "integer", "minimum": 0 },
        "rect_pdf_points": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
        "page_rotation_degrees": { "type": "integer", "minimum": -360, "maximum": 360 },
        "source_to_page_transform": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "number" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "extracted_block": {
      "type": "object",
      "required": ["block_id", "text", "region", "confidence"],
      "properties": {
        "block_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "text": { "type": "string" },
        "spoken_text": { "type": ["string", "null"] },
        "region": { "$ref": "#/$defs/source_region" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "layout_role": {
          "type": "string",
          "enum": ["abstract", "algorithm", "aside_text", "chart", "content", "formula", "doc_title", "figure_title", "footer", "footnote", "formula_number", "header", "image", "number", "paragraph_title", "reference", "reference_content", "seal", "table", "text", "vision_footnote", "unknown"]
        },
        "layout_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "layout_order": { "type": "integer", "minimum": 0 },
        "narration_disposition": { "enum": ["automatic", "on_demand", "never"] },
        "physical_page_index": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "additionalProperties": false
    },
    "page_extraction": {
      "type": "object",
      "required": ["document_fingerprint", "generation_id", "page_index", "blocks"],
      "properties": {
        "document_fingerprint": { "type": "string", "minLength": 1 },
        "generation_id": { "type": "string", "minLength": 1 },
        "page_index": { "type": "integer", "minimum": 0 },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/extracted_block" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
