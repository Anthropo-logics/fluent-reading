{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lf-v1/incremental-session.schema.json",
  "title": "LF v1 incremental processing session",
  "$defs": {
    "request": {
      "type": "object",
      "required": ["document_id", "page_count", "visible_page_index"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "page_count": { "type": "integer", "minimum": 1 },
        "visible_page_index": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["page_index", "state", "error_code"],
      "properties": {
        "page_index": { "type": "integer", "minimum": 0 },
        "state": { "enum": ["pending", "processing", "completed", "failed", "skipped"] },
        "error_code": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "required": ["session", "action", "page_index"],
      "properties": {
        "session": { "$ref": "#" },
        "action": { "enum": ["reprioritize", "cancel", "retry", "skip", "complete", "fail"] },
        "page_index": { "type": ["integer", "null"], "minimum": 0 },
        "error_code": { "type": ["string", "null"], "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["document_id", "visible_page_index", "cancelled", "pages"],
  "properties": {
    "document_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "visible_page_index": { "type": "integer", "minimum": 0 },
    "cancelled": { "type": "boolean" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
  },
  "additionalProperties": false
}
