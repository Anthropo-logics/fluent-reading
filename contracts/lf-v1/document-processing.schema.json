{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lf-v1/document-processing.schema.json",
  "title": "LF v1 digital document processing result",
  "type": "object",
  "required": ["document_id", "language", "requested_unit", "pages", "nfr6", "cer"],
  "properties": {
    "document_id": { "type": "string", "pattern": "^doc_[a-f0-9]{16}$" },
    "language": { "enum": ["es", "en", "pt"] },
    "requested_unit": { "enum": ["paragraph", "sentence"] },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "reading-page.schema.json" } },
    "nfr6": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["numerator", "denominator", "ratio", "threshold", "passed"],
          "properties": {
            "numerator": { "type": "integer", "minimum": 0 },
            "denominator": { "type": "integer", "minimum": 1 },
            "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "threshold": { "enum": [0.95, 0.98] },
            "passed": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    },
    "cer": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["distance", "reference_characters", "ratio", "threshold", "passed"],
          "properties": {
            "distance": { "type": "integer", "minimum": 0 },
            "reference_characters": { "type": "integer", "minimum": 0 },
            "ratio": { "type": "number", "minimum": 0 },
            "threshold": { "const": 0.05 },
            "passed": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
