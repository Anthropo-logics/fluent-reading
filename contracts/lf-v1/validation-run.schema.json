{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lf-v1/validation-run.schema.json",
  "title": "Lectura ValidationRun v1",
  "type": "object",
  "required": ["schema_version", "validation_run_id", "corpus_id", "corpus_hashes", "environment", "processing_route", "confidence", "duration_ms", "errors", "page_metrics", "status", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "validation_run_id": { "$ref": "#/$defs/id" },
    "corpus_id": { "$ref": "#/$defs/id" },
    "corpus_hashes": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hash" } },
    "environment": {
      "type": "object",
      "required": ["hardware", "operating_system", "rust", "app_revision", "processor_revision"],
      "properties": {
        "hardware": { "type": "string", "minLength": 1 },
        "operating_system": { "type": "string", "minLength": 1 },
        "rust": { "type": "string", "minLength": 1 },
        "app_revision": { "type": "string", "minLength": 1 },
        "processor_revision": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "processing_route": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "errors": { "type": "array", "items": { "type": "string", "pattern": "^LF_[A-Z0-9_]+$" } },
    "page_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "page_index", "metric", "numerator", "denominator", "value"],
        "properties": {
          "document_id": { "$ref": "#/$defs/id" },
          "page_index": { "type": "integer", "minimum": 0 },
          "metric": { "type": "string", "minLength": 1 },
          "numerator": { "type": "integer", "minimum": 0 },
          "denominator": { "type": "integer", "minimum": 0 },
          "value": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "status": { "enum": ["complete", "incomplete"] },
    "artifacts": {
      "type": "object",
      "required": ["environment_sha256", "metrics_sha256", "summary_sha256"],
      "properties": {
        "environment_sha256": { "$ref": "#/$defs/hash" },
        "metrics_sha256": { "$ref": "#/$defs/hash" },
        "summary_sha256": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
