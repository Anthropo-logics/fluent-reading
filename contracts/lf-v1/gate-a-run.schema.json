{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lf-v1/gate-a-run.schema.json",
  "title": "Lectura Gate A run v1",
  "type": "object",
  "required": ["request", "validation_run", "metrics", "resources"],
  "properties": {
    "request": { "$ref": "#/$defs/request" },
    "validation_run": { "$ref": "validation-run.schema.json" },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
    "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$" },
    "request": {
      "type": "object",
      "required": ["scenario", "condition", "corpus_id", "revisions", "expected_repetitions", "expected_duration_ms"],
      "properties": {
        "scenario": { "enum": ["integrated_chain", "boundary_cycle", "anchor_round_trip", "pause_resume", "sustained_session", "offline_privacy"] },
        "condition": { "enum": ["cold", "hot", "stress", "sustained", "offline"] },
        "corpus_id": { "$ref": "#/$defs/id" },
        "revisions": {
          "type": "object",
          "required": ["app", "corpus", "runtime", "model"],
          "properties": {
            "app": { "$ref": "#/$defs/id" },
            "corpus": { "$ref": "#/$defs/id" },
            "runtime": { "$ref": "#/$defs/id" },
            "model": { "$ref": "#/$defs/id" }
          },
          "additionalProperties": false
        },
        "expected_repetitions": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "expected_duration_ms": { "type": "integer", "minimum": 1, "maximum": 7200000 }
      },
      "additionalProperties": false
    },
    "progress": {
      "type": "object",
      "required": ["completed", "total", "monotonic_elapsed_ms"],
      "properties": {
        "completed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 },
        "monotonic_elapsed_ms": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": ["name", "unit", "repetition", "monotonic_elapsed_ms", "numerator", "denominator"],
      "properties": {
        "name": { "enum": ["open_to_first_frame", "open_to_first_unit", "pause_resume", "real_time_factor", "phys_footprint", "rss", "swap", "transport_ack", "boundary_cycle"] },
        "unit": { "enum": ["milliseconds", "bytes", "ratio", "count"] },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "monotonic_elapsed_ms": { "type": "integer", "minimum": 0 },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["monotonic_elapsed_ms", "phys_footprint_bytes", "rss_bytes", "swap_bytes", "boundary_elapsed_ms", "thermal_state"],
      "properties": {
        "monotonic_elapsed_ms": { "type": "integer", "minimum": 0 },
        "phys_footprint_bytes": { "type": "integer", "minimum": 0 },
        "rss_bytes": { "type": "integer", "minimum": 0 },
        "swap_bytes": { "type": "integer", "minimum": 0 },
        "boundary_elapsed_ms": { "type": "integer", "minimum": 1 },
        "thermal_state": { "enum": ["nominal", "fair", "serious", "critical"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
